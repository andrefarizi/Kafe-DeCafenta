generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  phone         String?   @db.VarChar(20)
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  staffDetail   StaffDetail?
  reviews       Review[]
  carts         Cart[]
  orders        Order[]      @relation("OrderCustomer")
  kasirOrders   Order[]      @relation("OrderKasir")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  OWNER
  KASIR
  CUSTOMER
}

enum WorkStatus {
  aktif
  non_aktif
}

enum OrderType {
  dine_in_app
  dine_in_kasir
}

enum OrderStatus {
  masuk
  dimasak
  siap_diambil
  selesai
  dibatalkan
}

enum PaymentMethod {
  cash
  ewallet
}

enum TableStatus {
  tersedia
  dipakai
}

model StaffDetail {
  id           String     @id @default(cuid())
  userId       String     @unique
  phone        String?    @db.VarChar(20)
  staffNumber  String     @unique @db.VarChar(20)
  workStatus   WorkStatus @default(aktif)
  joinedAt     DateTime   @default(now()) @db.Timestamptz()

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff_details")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(50)
  createdAt DateTime @default(now()) @db.Timestamptz()
  menus     Menu[]

  @@map("categories")
}

model Menu {
  id              String      @id @default(cuid())
  categoryId      String      
  name            String      @db.VarChar(100)
  description     String?     @db.Text
  price           Decimal     @db.Decimal(10, 2)
  imageUrl        String?     @db.Text
  isAvailable     Boolean     @default(true)
  isPromo         Boolean     @default(false)
  discountPercent Int         @default(0)
  avgRating       Decimal     @default(0.00) @db.Decimal(3, 2)
  createdAt       DateTime    @default(now()) @db.Timestamptz()
  updatedAt       DateTime    @updatedAt @db.Timestamptz()

  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  reviews     Review[]
  carts       Cart[]
  orderItems  OrderItem[]

  @@map("menus")
}

model Review {
  id        String   @id @default(cuid())
  menuId    String   
  userId    String   
  rating    Int      @db.SmallInt
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz()

  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Table {
  id          String      @id @default(cuid())
  name        String      @db.VarChar(50)
  tableCode   String      @unique @db.VarChar(20)
  status      TableStatus @default(tersedia)
  isInLayout  Boolean     @default(true)
  layoutSlot  Int?
  createdAt   DateTime    @default(now()) @db.Timestamptz()
  orders      Order[]

  @@map("tables")
}

model Cart {
  id       String   @id @default(cuid())
  userId   String   
  menuId   String   
  quantity Int      @default(1)
  notes    String?  @db.Text
  addedAt  DateTime @default(now()) @db.Timestamptz()

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  menu     Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([userId, menuId])
  @@map("carts")
}

model Order {
  id             String        @id @default(cuid())
  orderCode      String        @unique @db.VarChar(30)
  userId         String?       
  kasirId        String?       
  tableId        String?       
  customerName   String?       @db.VarChar(100)
  orderType      OrderType
  status         OrderStatus   @default(masuk)
  paymentMethod  PaymentMethod
  totalPrice     Decimal       @default(0.00) @db.Decimal(10, 2)
  isPaid         Boolean       @default(false)
  notes          String?       @db.Text
  orderedAt      DateTime      @default(now()) @db.Timestamptz()
  updatedAt      DateTime      @updatedAt @db.Timestamptz()

  user           User?         @relation("OrderCustomer", fields: [userId], references: [id], onDelete: SetNull)
  kasir          User?         @relation("OrderKasir", fields: [kasirId], references: [id], onDelete: SetNull)
  table          Table?        @relation(fields: [tableId], references: [id], onDelete: SetNull)
  orderItems     OrderItem[]
  invoice        Invoice?

  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String   
  menuId      String   
  quantity    Int
  customNotes String?  @db.Text
  unitPrice   Decimal  @db.Decimal(10, 2)
  subtotal    Decimal? @db.Decimal(10, 2) 
  isReviewed  Boolean  @default(false)

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menu        Menu     @relation(fields: [menuId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

model Invoice {
  id            String   @id @default(cuid())
  orderId       String   @unique 
  invoiceNumber String   @unique @db.VarChar(30)
  totalAmount   Decimal  @db.Decimal(10, 2)
  cashAmount    Decimal  @default(0.00) @db.Decimal(10, 2)
  ewalletAmount Decimal  @default(0.00) @db.Decimal(10, 2)
  issuedAt      DateTime @default(now()) @db.Timestamptz()

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("invoices")
}
